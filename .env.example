# Kubernetes deployment configuration
APP_NAME=myapp
NAMESPACE=myapp
ENVIRONMENT=production
IMAGE=myapp:latest
REPLICAS=2
APP_PORT=3000
SERVICE_PORT=80
SERVICE_TYPE=ClusterIP
INGRESS_HOST=myapp.example.com
INGRESS_CLASS=nginx
INGRESS_PATH=/
HEALTHCHECK_PATH=/health
MEMORY_REQUEST=128Mi
CPU_REQUEST=100m
MEMORY_LIMIT=256Mi
CPU_LIMIT=500m
