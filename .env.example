# Kubernetes deployment configuration
# Normally generated for you by: make configure
# All values are optional; defaults shown below apply when unset.

APP_NAME=myapp          # required in GitLab CI/CD variables too
NAMESPACE=myapp         # defaults to APP_NAME
ENVIRONMENT=production  # production, staging, dev, ...
IMAGE=myapp:latest      # in CI this is set automatically from the registry

REPLICAS=2              # how many copies of your app run
APP_PORT=3000           # port your app listens on inside the container
SERVICE_PORT=80         # port the Service exposes
SERVICE_TYPE=ClusterIP  # ClusterIP | NodePort | LoadBalancer

# Only if you want a public domain (otherwise leave empty):
INGRESS_HOST=myapp.example.com
INGRESS_CLASS=nginx
INGRESS_PATH=/

HEALTHCHECK_PATH=/health  # path that returns success when the app is healthy

MEMORY_REQUEST=128Mi
CPU_REQUEST=100m
MEMORY_LIMIT=256Mi
CPU_LIMIT=500m

# Extra environment variables passed to your app, comma-separated:
# EXTRA_ENV=API_URL=https://x,LOG_LEVEL=debug
EXTRA_ENV=

# Secret variable NAMES only (never values). Values come from your GitLab
# CI/CD variables (Masked + Protected) or from .env for local runs:
# SECRETS=DB_PASSWORD,API_KEY
SECRETS=
